{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./_REVISAR/**)",
      "Write(./_REVISAR/**)",
      "Edit(./**/_originais/**)",
      "Write(./**/_originais/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler publish *)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "Bash(npm view *)",
      "Bash(npm run typecheck)",
      "Bash(npm run validate)",
      "Bash(npm run test*)",
      "Bash(python -m http.server *)"
    ]
  }
}
